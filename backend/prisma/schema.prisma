// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPERADMIN
  ADMIN
  USER
  MODERATOR
  SUPPORT
  PROVIDER
  COMPANY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum RequirementType {
  CERTIFICATION
  PROFESSIONAL_TITLE
  PROFESSIONAL_CARD
  IDENTITY_DOCUMENT
  OTHER
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique @default(uuid())
  email         String     @unique @db.VarChar(191)
  password      String     @db.VarChar(255)
  firstName     String     @db.VarChar(100)
  lastName      String     @db.VarChar(100)
  phone         String?    @db.VarChar(30)
  roleId        Int
  status        UserStatus @default(PENDING)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  role            Role             @relation(fields: [roleId], references: [id])
  profile         Profile?
  providerProfile ProviderProfile?

  @@map("users")
}

model Profile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  profilePhoto String?  @db.VarChar(255)
  bio          String?  @db.Text
  city         String?  @db.VarChar(100)
  department   String?  @db.VarChar(100)
  country      String?  @default("Colombia") @db.VarChar(100)
  address      String?  @db.VarChar(255)
  latitude     Float?
  longitude    Float?
  website      String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ProviderProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  title        String?  @db.VarChar(100)
  hourlyRate   Decimal? @db.Decimal(10, 2)
  isVerified   Boolean  @default(false)
  rating       Float    @default(0)
  totalReviews Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerServices ProviderService[]

  @@map("provider_profiles")
}

model ProviderService {
  id                Int      @id @default(autoincrement())
  providerProfileId Int
  serviceId         Int
  createdAt         DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, serviceId])
  @@map("provider_services")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services     Service[]
  requirements CategoryRequirement[]

  @@map("categories")
}

model CategoryRequirement {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  title       String          @db.VarChar(100)
  type        RequirementType
  isRequired  Boolean         @default(true)
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_requirements")
}

model Service {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerServices ProviderService[]

  @@map("services")
}

model Cuadrilla {
  id                    Int                 @id @default(autoincrement())
  name                  String              @db.VarChar(150)
  slug                  String              @unique @db.VarChar(150)
  category              String              @db.VarChar(100)
  categoryId            Int?
  leaderName            String              @db.VarChar(100)
  leaderPhone           String?             @db.VarChar(30)
  city                  String              @default("Cali") @db.VarChar(100)
  department            String              @default("Valle del Cauca") @db.VarChar(100)
  rating                Float               @default(4.9)
  reviewsCount          Int                 @default(0)
  isVerified            Boolean             @default(true)
  badge                 String?             @db.VarChar(100)
  image                 String?             @db.VarChar(255)
  description           String              @db.Text
  hourlyRate            Decimal             @db.Decimal(10, 2)
  dailyRate             Decimal             @db.Decimal(10, 2)
  fulfillmentRate       Decimal             @db.Decimal(10, 2)
  preferredPricingModel String              @default("POR_DIA") @db.VarChar(30)
  activities            String              @db.Text
  coverage              String?             @db.VarChar(255)
  experienceYears       Int                 @default(3)
  completedJobs         Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  members               CuadrillaMember[]
  proposals             CuadrillaProposal[]

  @@map("cuadrillas")
}

model CuadrillaMember {
  id          Int       @id @default(autoincrement())
  cuadrillaId Int
  name        String    @db.VarChar(100)
  role        String    @db.VarChar(100)
  experience  String    @db.VarChar(50)
  specialty   String    @db.VarChar(100)
  createdAt   DateTime  @default(now())

  cuadrilla   Cuadrilla @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)

  @@map("cuadrilla_members")
}

model CuadrillaProposal {
  id                Int       @id @default(autoincrement())
  cuadrillaId       Int
  clientName        String    @db.VarChar(100)
  clientPhone       String    @db.VarChar(30)
  clientEmail       String?   @db.VarChar(191)
  projectName       String    @db.VarChar(200)
  description       String    @db.Text
  pricingModel      String    @db.VarChar(30)
  proposedRate      Decimal   @db.Decimal(10, 2)
  estimatedDuration String    @db.VarChar(100)
  status            String    @default("PROPUESTA_ENVIADA") @db.VarChar(50)
  agreementNotes    String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cuadrilla         Cuadrilla @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)

  @@map("cuadrilla_proposals")
}
