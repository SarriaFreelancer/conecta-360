// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPERADMIN
  ADMIN
  USER
  MODERATOR
  SUPPORT
  PROVIDER
  COMPANY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum RequirementType {
  CERTIFICATION
  PROFESSIONAL_TITLE
  PROFESSIONAL_CARD
  IDENTITY_DOCUMENT
  OTHER
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique @default(uuid())
  email         String     @unique @db.VarChar(191)
  password      String     @db.VarChar(255)
  firstName     String     @db.VarChar(100)
  lastName      String     @db.VarChar(100)
  phone         String?    @db.VarChar(30)
  roleId        Int
  status        UserStatus @default(PENDING)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  role            Role             @relation(fields: [roleId], references: [id])
  profile         Profile?
  providerProfile ProviderProfile?

  bookingsAsClient   Booking[]      @relation("ClientBookings")
  bookingsAsProvider Booking[]      @relation("ProviderBookings")
  reviewsGiven       Review[]       @relation("ClientReviews")
  reviewsReceived    Review[]       @relation("ProviderReviews")
  notifications      Notification[]

  @@map("users")
}

model Profile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  profilePhoto     String?  @db.VarChar(255)
  bio              String?  @db.Text
  city             String?  @db.VarChar(100)
  department       String?  @db.VarChar(100)
  country          String?  @default("Colombia") @db.VarChar(100)
  address          String?  @db.VarChar(255)
  whatsappNumber   String?  @db.VarChar(30)
  showWhatsApp     Boolean  @default(true)
  reputationPoints Int      @default(100)
  negativePoints   Int      @default(0)
  latitude         Float?
  longitude        Float?
  website          String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ProviderProfile {
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @unique
  title                 String?                @db.VarChar(100)
  hourlyRate            Decimal?               @db.Decimal(10, 2)
  isVerified            Boolean                @default(false)
  rating                Float                  @default(0)
  totalReviews          Int                    @default(0)
  experienceYears       Int                    @default(5)
  coverageZones         String?                @db.VarChar(255)
  activities            String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerServices      ProviderService[]
  verificationDocuments VerificationDocument[]

  @@map("provider_profiles")
}

model ProviderService {
  id                Int      @id @default(autoincrement())
  providerProfileId Int
  serviceId         Int
  createdAt         DateTime @default(now())

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, serviceId])
  @@map("provider_services")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services     Service[]
  requirements CategoryRequirement[]

  @@map("categories")
}

model CategoryRequirement {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  title       String          @db.VarChar(100)
  type        RequirementType
  isRequired  Boolean         @default(true)
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_requirements")
}

model Service {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerServices ProviderService[]

  @@map("services")
}

model Cuadrilla {
  id                    Int                 @id @default(autoincrement())
  name                  String              @db.VarChar(150)
  slug                  String              @unique @db.VarChar(150)
  category              String              @db.VarChar(100)
  categoryId            Int?
  leaderName            String              @db.VarChar(100)
  leaderPhone           String?             @db.VarChar(30)
  city                  String              @default("Cali") @db.VarChar(100)
  department            String              @default("Valle del Cauca") @db.VarChar(100)
  rating                Float               @default(4.9)
  reviewsCount          Int                 @default(0)
  isVerified            Boolean             @default(true)
  badge                 String?             @db.VarChar(100)
  image                 String?             @db.VarChar(255)
  description           String              @db.Text
  hourlyRate            Decimal             @db.Decimal(10, 2)
  dailyRate             Decimal             @db.Decimal(10, 2)
  fulfillmentRate       Decimal             @db.Decimal(10, 2)
  preferredPricingModel String              @default("POR_DIA") @db.VarChar(30)
  activities            String              @db.Text
  coverage              String?             @db.VarChar(255)
  experienceYears       Int                 @default(3)
  completedJobs         Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  members               CuadrillaMember[]
  proposals             CuadrillaProposal[]

  @@map("cuadrillas")
}

model CuadrillaMember {
  id          Int       @id @default(autoincrement())
  cuadrillaId Int
  name        String    @db.VarChar(100)
  role        String    @db.VarChar(100)
  experience  String    @db.VarChar(50)
  specialty   String    @db.VarChar(100)
  createdAt   DateTime  @default(now())

  cuadrilla   Cuadrilla @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)

  @@map("cuadrilla_members")
}

model CuadrillaProposal {
  id                Int       @id @default(autoincrement())
  cuadrillaId       Int
  clientName        String    @db.VarChar(100)
  clientPhone       String    @db.VarChar(30)
  clientEmail       String?   @db.VarChar(191)
  projectName       String    @db.VarChar(200)
  description       String    @db.Text
  pricingModel      String    @db.VarChar(30)
  proposedRate      Decimal   @db.Decimal(10, 2)
  estimatedDuration String    @db.VarChar(100)
  status            String    @default("PROPUESTA_ENVIADA") @db.VarChar(50)
  agreementNotes    String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  cuadrilla         Cuadrilla @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)

  @@map("cuadrilla_proposals")
}

model Booking {
  id                   Int                @id @default(autoincrement())
  clientId             Int
  providerId           Int
  serviceTitle         String             @db.VarChar(150)
  categoryName         String             @db.VarChar(100)
  amount               Decimal            @db.Decimal(10, 2)
  status               BookingStatus      @default(SOLICITADO)
  paymentMethod        String             @default("Transferencia Bancaria") @db.VarChar(50)
  paymentStatus        PaymentStatus      @default(PENDIENTE)
  platformFee          Decimal            @default(0) @db.Decimal(10, 2)
  platformDebtStatus   PlatformDebtStatus @default(EN_DEUDA)
  estimatedTimeRange   String             @default("2 a 4 horas") @db.VarChar(100)
  locationZone         String?            @db.VarChar(150)
  bookingDate          DateTime?
  dateString           String?            @db.VarChar(100)
  notes                String?            @db.Text
  rejectionReason      String?            @db.VarChar(200)
  rejectionExplanation String?            @db.Text
  teamBookingId        String?            @db.VarChar(100)
  teamProjectName      String?            @db.VarChar(200)
  teamMembersCount     Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  client               User               @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  provider             User               @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  reviews              Review[]

  @@map("bookings")
}

model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int?
  clientId   Int
  providerId Int
  rating     Float
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  client     User     @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)
  provider   User     @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id             Int      @id @default(autoincrement())
  userId         Int
  title          String   @db.VarChar(150)
  message        String   @db.Text
  type           String   @default("SYSTEM") @db.VarChar(50)
  isRead         Boolean  @default(false)
  link           String?  @db.VarChar(255)
  actionRequired Boolean  @default(false)
  serviceId      String?  @db.VarChar(100)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model VerificationDocument {
  id                Int             @id @default(autoincrement())
  providerProfileId Int
  documentType      String          @db.VarChar(50)
  documentNumber    String?         @db.VarChar(100)
  fileUrl           String          @db.VarChar(255)
  status            DocumentStatus  @default(PENDIENTE)
  reviewNotes       String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

enum BookingStatus {
  SOLICITADO
  CONFIRMADO
  EN_PROGRESO
  COMPLETADO
  CANCELADO
  RECHAZADO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
}

enum PlatformDebtStatus {
  EN_DEUDA
  AL_DIA
  NO_APLICA
}

enum DocumentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model SystemSetting {
  id                          Int      @id @default(autoincrement())
  platformName                String   @default("CONECTA 360") @db.VarChar(100)
  primarySlogan               String   @default("Conecta lo que necesitas con quien puede hacerlo.") @db.VarChar(200)
  secondarySlogan             String   @default("Necesitas. Encuentras. Contratas.") @db.VarChar(200)
  country                     String   @default("Colombia") @db.VarChar(50)
  currency                    String   @default("COP ($)") @db.VarChar(20)
  defaultCity                 String   @default("Cali") @db.VarChar(100)
  defaultDepartment           String   @default("Valle del Cauca") @db.VarChar(100)
  supportEmail                String   @default("contacto@conecta360.co") @db.VarChar(100)
  supportPhone                String   @default("+57 315 789 4521") @db.VarChar(30)
  supportWhatsApp             String   @default("+57 315 789 4521") @db.VarChar(30)
  platformCommission          Float    @default(5.0)
  minPlatformFee              Decimal  @default(2500) @db.Decimal(10, 2)
  minHourlyRate               Decimal  @default(25000) @db.Decimal(10, 2)
  freePlanMaxServices         Int      @default(1)
  maxActivitiesPerService     Int      @default(10)
  requireIdentityVerification Boolean  @default(true)
  requirePoliceRecord         Boolean  @default(true)
  cashTransferDebtEnabled     Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("system_settings")
}
